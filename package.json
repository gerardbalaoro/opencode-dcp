{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "@tarquinen/opencode-dcp",
    "version": "3.1.14",
    "type": "module",
    "packageManager": "bun@1.3.14",
    "description": "OpenCode plugin that optimizes token usage by pruning obsolete tool outputs from conversation context",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./server": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./tui": {
            "types": "./dist/tui.d.ts",
            "import": "./src/tui.tsx"
        }
    },
    "scripts": {
        "clean": "rm -rf dist",
        "build": "tsdown && tsc --emitDeclarationOnly",
        "verify:package": "node scripts/verify-package.mjs",
        "check:package": "bun run build && bun run verify:package",
        "prepublishOnly": "bun run check:package",
        "dev": "opencode plugin dev",
        "typecheck": "tsc --noEmit",
        "test": "node --import tsx --test tests/*.test.ts",
        "lint": "oxlint .",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "dcp": "bun scripts/print.ts"
    },
    "keywords": [
        "opencode",
        "opencode-plugin",
        "plugin",
        "context",
        "pruning",
        "optimization",
        "tokens"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Opencode-DCP/opencode-dynamic-context-pruning.git"
    },
    "bugs": {
        "url": "https://github.com/Opencode-DCP/opencode-dynamic-context-pruning/issues"
    },
    "homepage": "https://github.com/Opencode-DCP/opencode-dynamic-context-pruning#readme",
    "author": "tarquinen",
    "license": "AGPL-3.0-or-later",
    "peerDependencies": {
        "@opencode-ai/plugin": ">=1.17.0 <1.19.0",
        "@opentui/core": ">=0.4.3 <=0.5.1",
        "@opentui/solid": ">=0.4.3 <=0.5.1",
        "solid-js": "1.9.12"
    },
    "dependencies": {
        "@anthropic-ai/tokenizer": "^0.0.4",
        "@opencode-ai/sdk": "^1.4.3",
        "jsonc-parser": "^3.3.1"
    },
    "devDependencies": {
        "@opencode-ai/plugin": "1.18.13",
        "@opentui/core": "0.5.1",
        "@opentui/solid": "0.5.1",
        "@types/node": "^24.0.0",
        "oxfmt": "0.62.0",
        "oxlint": "1.77.0",
        "solid-js": "1.9.12",
        "tsdown": "0.22.14",
        "tsx": "^4.21.0",
        "typescript": "^6.0.2"
    },
    "overrides": {
        "@babel/core": "7.29.7",
        "esbuild": "0.28.1"
    },
    "files": [
        "dist/",
        "src/lib/",
        "src/tui.tsx",
        "README.md",
        "LICENSE"
    ]
}
